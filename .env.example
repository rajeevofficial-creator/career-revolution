# Career Revolution - Environment Configuration

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose which AI provider to use: "gemini" (default) or "claude"
LLM_PROVIDER=gemini

# Gemini API Key — required when LLM_PROVIDER=gemini
# Get yours: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key — required when LLM_PROVIDER=claude
# Get yours: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./career_revolution.db

# JWT Secret Key (Change this in production!)
SECRET_KEY=yoursecretkeyhere_atleast32characterslong
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440